# Copy to .env, replace placeholders, and never commit .env.
POSTGRES_USER=typeshift
POSTGRES_PASSWORD=replace-with-a-local-database-password
POSTGRES_DB=typeshift
DEV_DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/typeshift
JWT_SECRET=replace-with-a-random-local-secret
COOKIE_SECURE=false
GEMINI_API_KEY=replace-with-your-Gemini-API-key
